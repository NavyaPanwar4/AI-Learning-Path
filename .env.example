# ==========================================
# Security — set a real random value locally.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# ==========================================
SECRET_KEY=change-me-to-a-long-random-value
ENVIRONMENT=development
AUTO_CREATE_SCHEMA=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==========================================
# Groq LLM — primary provider for all AI generation and tutor chat
# Create a key at https://console.groq.com/keys
# ==========================================
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
GROQ_QUIZ_TIMEOUT_SECONDS=45
GROQ_MAX_COMPLETION_TOKENS=4096
GROQ_REASONING_EFFORT=medium

# ==========================================
# Optional local Hugging Face fallback (off by default — heavy, requires
# torch/transformers; see requirements.txt)
# ==========================================
ENABLE_HF_FALLBACK=false

# ==========================================
# Web Search (resource discovery)
# ==========================================
TAVILY_API_KEY=your_tavily_api_key

# ==========================================
# Semantic skill matching (sentence-transformer embeddings)
# ==========================================
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_MATCH_THRESHOLD=0.6

# Optional — enables metadata-based YouTube ranking. Without it, YouTube
# results are still included, just without API-based quality scoring.
YOUTUBE_API_KEY=

# ==========================================
# Database (defaults to a local SQLite file under app/data/ if left unset)
# ==========================================
DATABASE_URL=

# ==========================================
# Password reset emails — leave SMTP_HOST empty to just log the reset link
# to the console instead of sending a real email (fine for local dev)
# ==========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@learningpath.local
FRONTEND_URL=http://localhost:5173
WEB_SEARCH_CACHE_TTL_SECONDS=86400
ADMIN_EMAILS=
# ==========================================
# Roadmap generation strategy
# LLM-first proposals are validated deterministically for all goals.
# Curated goals are restricted to their reviewed skill catalogue; uncurated
# goals may include prerequisite skills from the graph closure.
# The existing planner remains the fallback if LLM-first generation fails.
# ==========================================
USE_PATH_PLANNER=true
USE_LLM_FIRST_VALIDATED_ROADMAP=true
PLANNER_WEAK_THRESHOLD=0.50
PLANNER_STRONG_THRESHOLD=0.85

# Required outside development/test for shared rate limits
# RATE_LIMIT_REDIS_URL=redis://localhost:6379/0

REMINDER_EMAILS_ENABLED=true